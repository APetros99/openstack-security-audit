[security_audit]
# clouds.yaml entry used by openstacksdk.
cloud = devstack-admin

# API polling frequency. The minimum accepted value is 5 seconds.
poll_interval = 30
database_path = /var/lib/security-audit/audit.db
report_dir = /var/lib/security-audit/reports
log_file = /var/log/security-audit/audit.log
log_level = INFO

# Apache access log containing Keystone token requests (POST .../v3/auth/tokens).
# On DevStack the Horizon virtual host logs all port-80 traffic, /identity
# included. Leave empty to disable access monitoring.
keystone_access_log = /var/log/apache2/horizon_access.log

# False creates a baseline on first run. True records existing resources as created.
emit_initial_state = false

